{
  "name": "tap-translate-extension",
  "description": "TapTranslate — bilingual/replacement page translation via any OpenAI-compatible API.",
  "private": true,
  "license": "MIT",
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "clean": "node tools/clean-artifacts.mjs",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:perf": "playwright test --project=chromium-ext e2e/perf.spec.ts",
    "e2e:perf:full": "PERF_FULL=1 playwright test --project=chromium-ext e2e/perf.spec.ts",
    "audit:runtime": "npm audit --omit=dev --audit-level=moderate",
    "probe": "node tools/collector-probe/run.mjs",
    "probe:live": "node tools/live-translate-probe/run.mjs",
    "probe:live:chrome": "node tools/live-translate-probe/run.mjs --browser=chrome",
    "probe:live:firefox": "node tools/live-translate-probe/run.mjs --browser=firefox"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.0.270",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.1.3",
    "eslint": "^9.22.0",
    "jsdom": "^25.0.1",
    "playwright-webextext": "^0.0.5",
    "postcss": "8.5.28",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.5",
    "wxt": "^0.19.13"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.5",
    "@astryxdesign/theme-neutral": "0.6.5",
    "@stylexjs/stylex": "0.19.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^3.23.8"
  }
}
