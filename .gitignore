# Configurable build outputs, reports and caches
/artifacts/
*.zip
*.tar.gz
*.tgz
*.crx
*.xpi
*.tsbuildinfo

# Tool-managed directories (npm and WXT keep these beside package.json)
node_modules/
.wxt/

# Tool defaults when invoked without the repository output configuration
.output/
dist/
.vite/
.vitest/
.cache/
.eslintcache
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/

# Extension: local-only / never package
/extension/dev-settings.json
/extension/public/dev-settings.json

# Accidental leftover (WXT public dir is extension/public/)
/public/

# Env / secrets (defense in depth; also gated by check-extension-artifacts)
.env
.env.*
!.env.example
!.env.*.example
**/credentials.json
**/*.pem

# MCP server configuration (local overrides, may contain secrets)
.mcp.json

# Logs / OS / IDE
*.log
.idea/
.vscode/
.cursor/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local agent instructions (not part of the published project)
/.plan/
/AGENTS.md
CLAUDE.md
.cursorrules
.windsurfrules
.claude/
.opencode/
.aider*
.cline/
.continue/
.codex/
.gemini/
.github/copilot-instructions.md
